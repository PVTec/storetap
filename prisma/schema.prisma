// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model License {
  id             String    @id @default(cuid())
  licenseKey     String    @unique
  userId         String?   // User who bought/claimed the license
  tier           String    // free, standard, pro
  status         String    @default("unused") // unused, active, expired, banned
  deviceId       String?   // Hardware ID of the device it's bound to
  websiteUrl     String?   // The domain/URL where the license is used
  durationDays   Int       @default(30)
  activatedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model LicenseRequest {
  id             String    @id @default(cuid())
  userId         String?   // User ID if logged in via Supabase
  name           String
  email          String
  contactNumber  String
  tier           String    // free, standard, pro
  status         String    @default("pending") // pending, approved, rejected
  licenseKey     String?   // Auto-generated key hidden until approved
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   // 'admin' or actual user ID
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemRequest {
  id             String    @id @default(cuid())
  userId         String?   // User ID if logged in via Supabase
  name           String
  email          String
  contactNumber  String
  backupContact  String
  storeName      String?
  type           String    // 'web' or 'app'
  status         String    @default("pending") // pending, approved, rejected
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
